{
  "$id": "action",
  "allOf": [
    {
      "$ref": "record-base"
    },
    {
      "type": "object",
      "required": [
        "driver",
        "purpose",
        "inputs",
        "outputs",
        "dependencies",
        "acceptance",
        "risks",
        "writer",
        "next_step",
        "domain",
        "size",
        "blockers"
      ],
      "properties": {
        "type": {
          "const": "action"
        },
        "driver": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3,}$"
        },
        "purpose": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          }
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "array"
        },
        "writer": {
          "type": "string"
        },
        "next_step": {
          "type": "string"
        },
        "domain": {
          "enum": [
            "experiment",
            "analysis",
            "writing",
            "coordination",
            "unclassified"
          ]
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large",
            "unestimated"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "owner",
              "since",
              "next_unblock_action",
              "review_at",
              "status",
              "resolved_at",
              "id",
              "category",
              "critical_path",
              "root_cause",
              "resolution"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "since": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "next_unblock_action": {
                "type": "string",
                "minLength": 1
              },
              "review_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "status": {
                "enum": [
                  "active",
                  "resolved"
                ]
              },
              "resolved_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "category": {
                "enum": [
                  "approval",
                  "network",
                  "resource",
                  "implementation",
                  "validation",
                  "dependency",
                  "other"
                ]
              },
              "critical_path": {
                "type": "boolean"
              },
              "root_cause": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "resolution": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "check_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "candidate_version": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "active"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "resolved_at": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "resolved"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "resolved_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "resolution": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            ]
          }
        },
        "candidate_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "validation_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier",
            "checks"
          ],
          "properties": {
            "tier": {
              "enum": [
                "scientific",
                "implementation",
                "presentation"
              ]
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "description",
                  "max_attempts"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "max_attempts": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "operation_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operations",
            "paths",
            "resources"
          ],
          "properties": {
            "operations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "minItems": 1
            },
            "paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "resources": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "validation_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "candidate_version",
              "outcome",
              "evidence",
              "at"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "candidate_version": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "outcome": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "validation_revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_version",
              "validation_plan",
              "operation_scope",
              "reason",
              "at"
            ],
            "properties": {
              "candidate_version": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "validation_plan": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tier",
                  "checks"
                ],
                "properties": {
                  "tier": {
                    "enum": [
                      "scientific",
                      "implementation",
                      "presentation"
                    ]
                  },
                  "checks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "description",
                        "max_attempts"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "max_attempts": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                }
              },
              "operation_scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operations",
                  "paths",
                  "resources"
                ],
                "properties": {
                  "operations": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1
                  },
                  "paths": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "resources": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "validation_acceptance": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_version",
                "accepted_by",
                "accepted_at",
                "reason"
              ],
              "properties": {
                "candidate_version": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "accepted_by": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "accepted_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          ]
        },
        "scope_approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "grant_id",
              "approver",
              "reason",
              "scope",
              "approved_at"
            ],
            "properties": {
              "grant_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "approver": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operations",
                  "paths",
                  "resources"
                ],
                "properties": {
                  "operations": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1
                  },
                  "paths": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "resources": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resources",
            "writable_paths",
            "resource_observation"
          ],
          "properties": {
            "resources": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "writable_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "resource_observation": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "observed_at",
                    "source",
                    "available"
                  ],
                  "properties": {
                    "observed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "available": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
